; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="طلعة - TAL'A"
config/description="Vertical climbing game"
run/main_scene="res://scenes/main.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.06, 0.09, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

general/text_to_speech=true

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/audio.gd"
DevShot="*res://scripts/dev_shot.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[gui]

theme/custom_font="res://assets/fonts/Cairo.ttf"

